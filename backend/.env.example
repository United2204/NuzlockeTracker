# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/nuzlocke_tracker_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT — generá un secreto seguro con: openssl rand -base64 64
JWT_SECRET=

# Google OAuth — desde https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail (dev: usá Mailpit o Mailtrap)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# URLs
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev
